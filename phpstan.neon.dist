parameters:
    # Every runtime the package supports: a finding on any version in the range is reported.
    phpVersion:
        min: 80200
        max: 80500
    # Level 3 is the floor every extension starts from. Raise it in a package that can carry
    # it -- belisoful/prado-bayesian runs at level 9 -- but do not lower it here.
    level: 3
    bootstrapFiles:
        - tests/test_tools/phpstan-bootstrap.php
    paths:
        - src
        - tests/unit
        - tests/test_tools
    ignoreErrors:
        # TMetaBehavior gives every IUser these methods at runtime, as a class behavior; the
        # framework's reflection extensions cannot see a behavior attached by a module's init().
        -
            message: '#^Call to an undefined method (Prado\\Security\\TUser|MetaTestUserWithId)::(get|set|unset|exists|getAll)Meta\(\)\.$#'
            identifier: method.notFound
            path: tests/*

# PRADO components resolve methods and properties at runtime (behaviors, dynamic events, and
# the get/set property convention), which PHPStan cannot see on its own. These extensions ship
# with the framework and teach it those rules; without them a TComponent subclass reports false
# positives on every dynamic call and property.
services:
    -
        class: Prado\PHPStan\DynamicMethodsClassReflectionExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension
    -
        class: Prado\PHPStan\TComponentPropertiesReflectionExtension
        tags:
            - phpstan.broker.propertiesClassReflectionExtension
    -
        class: Prado\PHPStan\TComponentHasMethodTypeSpecifyingExtension
        tags:
            - phpstan.typeSpecifier.methodTypeSpecifyingExtension
    -
        class: Prado\PHPStan\TComponentCanGetPropertyTypeSpecifyingExtension
        tags:
            - phpstan.typeSpecifier.methodTypeSpecifyingExtension
    -
        class: Prado\PHPStan\TComponentCanSetPropertyTypeSpecifyingExtension
        tags:
            - phpstan.typeSpecifier.methodTypeSpecifyingExtension
    -
        class: Prado\PHPStan\TComponentIsaTypeSpecifyingExtension
        tags:
            - phpstan.typeSpecifier.methodTypeSpecifyingExtension
    -
        class: Prado\PHPStan\PradoMethodVisibleStaticMethodTypeSpecifyingExtension
        tags:
            - phpstan.typeSpecifier.staticMethodTypeSpecifyingExtension
